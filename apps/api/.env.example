# ============================================================================
# Rigabras API - variáveis de ambiente (exemplo). Copie para .env e preencha.
# NUNCA commitar o arquivo .env real.
# ============================================================================

NODE_ENV=development
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info

# Supabase (projeto de desenvolvimento) - substitua pelos valores reais do seu projeto
SUPABASE_URL=your-supabase-url-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# JWT / sessão
JWT_ACCESS_SECRET=your-jwt-access-secret-here-change-me
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=your-cookie-secret-here-change-me

# Groq (IA para análise de risco / anomalias / RIGABRAS AI)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# Redis (cache / filas - reservado para módulos futuros)
REDIS_URL=redis://localhost:6379

# CORS
WEB_ORIGIN=http://localhost:5173

# Segurança (ver PROMPT_APRIMORADOR.md)
# Nº de proxies reversos à frente da API (ex.: 1 com Traefik/Coolify). Vazio = confia em X-Forwarded-For.
TRUST_PROXY_HOPS=
# false = só o SUPERADMIN cria usuários (recomendado em produção). Padrão: true.
ALLOW_PUBLIC_REGISTRATION=true
